#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define MOUSE 6

// ===== JISマクロ =====

#define JP_PLUS         LS(SEMICOLON)      // +
#define JP_CARET        EQUAL              // ^
#define JP_AMPERSAND    LS(N6)             // &
#define JP_TILDE        LS(EQUAL)          // ~
#define JP_ASTERISK     LS(QUOT)           // *
#define JP_AT           LEFT_BRACKET       // @
#define JP_EQUAL        LS(MINUS)          // =
#define JP_COLON        QUOT               // :
#define JP_LPAREN       LS(N8)             // (
#define JP_RPAREN       LS(N9)             // )
#define JP_LBRACKET     RIGHT_BRACKET      // [
#define JP_RBRACKET     BACKSLASH          // ]
#define JP_LBRACE       LS(RIGHT_BRACKET)  // {
#define JP_RBRACE       LS(BACKSLASH)      // }
#define JP_YEN          INT3               // ￥
#define JP_UNDERSCORE   LS(INT1)           // _

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

/ {
    combos { compatible = "zmk,combos"; };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    lt_to_layer_0: lt_to_layer_0 {
        compatible = "zmk,behavior-hold-tap";
        label = "LAYER_TAP_TO_0";
        bindings = <&mo>, <&to_layer_0>;

        #binding-cells = <2>;
        tapping-term-ms = <250>;
        flavor = "tap-preferred";
    };
};

/ {
    behaviors {
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q                   &kp W           &kp E             &kp R         &kp T        &kp Y             &kp U             &kp I        &kp O       &kp P
&kp A                   &kp S           &kp D             &kp F         &kp G        &kp H             &kp J             &kp K        &kp L       &mt LS(RIGHT_ALT) MINUS
&mt LEFT_SHIFT Z        &kp X           &kp C             &kp V         &kp B        &kp TAB           &kp DEL           &kp B        &kp N       &kp M
&mt LEFT_CONTROL COMMA  &mt RSHIFT DOT  &kp LEFT_CONTROL  &kp LEFT_WIN  &lt 3 SPACE  &lt 1 LANGUAGE_2  &lt 1 LANGUAGE_1  &lt 2 ENTER  &kp ESCAPE  &kp BACKSPACE
            >;
        };

        layer_1 {
            bindings = <
&kp N1                   &kp N2                     &kp N3  &kp MINUS   &kp JP_PLUS      &kp JP_CARET     &kp JP_AMPERSAND  &kp JP_TILDE   &kp JP_LBRACKET  &kp JP_RBRACKET
&kp N4                   &kp N5                     &kp N6  &kp SLASH   &kp JP_ASTERISK  &kp EXCLAMATION  &kp JP_AT         &kp HASH       &kp DOLLAR       &kp PERCENT
&kp N7                   &kp N8                     &kp N9  &kp PERIOD  &kp JP_EQUAL     &mo 2            &kp JP_COLON      &kp SEMICOLON  &kp JP_LPAREN    &kp JP_RPAREN
&kp LS(INTERNATIONAL_1)  &mt RIGHT_SHIFT LS(SLASH)  &kp N0  &kp N0      &kp INT3         &kp LS(N2)       &kp LS(N7)        &trans         &kp LS(COMMA)    &kp LS(PERIOD)
            >;
        };

        layer_2 {
            bindings = <
&kp F1          &kp F2  &kp F3  &kp F4  &kp F5   &kp C_MUTE    &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp C_BRI_DN  &kp C_BRI_UP
&kp F6          &kp F7  &kp F8  &kp F9  &kp F10  &bt BT_SEL 0  &bt BT_SEL 1       &bt BT_SEL 2     &bt BT_SEL 3  &bt BT_SEL 4
&trans          &trans  &trans  &trans  &kp F11  &kp F12       &trans             &kt LS(CLCK)     &bt BT_CLR    &bootloader
&bt BT_CLR_ALL  &trans  &trans  &trans  &trans   &trans        &trans             &trans           &trans        &trans
            >;
        };

        layer_3 {
            bindings = <
&kp ESCAPE      &kp LC(LS(TAB))         &kp UP_ARROW    &kp LC(TAB)              &trans   &trans        &trans          &mkp LCLK       &mkp MCLK           &mkp RCLK
&kp HOME        &kp LEFT_ARROW          &kp DOWN_ARROW  &kp RIGHT_ARROW          &kp END  &msc SCRL_UP  &trans          &mkp LCLK       &kp UP_ARROW        &mkp RCLK
&kp LEFT_SHIFT  &kp LG(LS(LEFT_ARROW))  &trans          &kp LG(LS(RIGHT_ARROW))  &trans   &trans        &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_RIGHT     &kp LEFT_ARROW
&kp DOWN_ARROW  &kp RIGHT_ARROW         &trans          &trans                   &trans   &trans        &trans          &trans          &kp LA(LEFT_ARROW)  &kp LA(RIGHT_ARROW)
            >;
        };

        MOUSE {
            bindings = <
&kp ESCAPE           &kp LC(LS(TAB))         &kp UP_ARROW    &kp LC(TAB)              &trans   &trans  &trans     &msc SCRL_UP  &trans              &trans
&kp HOME             &kp LEFT_ARROW          &kp DOWN_ARROW  &kp RIGHT_ARROW          &kp END  &trans  &mkp LCLK  &mkp MCLK     &mkp RCLK           &trans
&kp LEFT_SHIFT       &kp LG(LS(LEFT_ARROW))  &trans          &kp LG(LS(RIGHT_ARROW))  &trans   &trans  &trans     &trans        &kp LA(LEFT_ARROW)  &msc SCRL_DOWN
&kp LA(RIGHT_ARROW)  &trans                  &trans          &trans                   &trans   &trans  &trans     &trans        &trans              &trans
            >;
        };
    };
};
