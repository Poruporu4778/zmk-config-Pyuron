#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#define MOUSE 6

// ===== JISマクロ =====
#define JP_PLUS         LS(SEMICOLON)      // +
#define JP_CARET        EQUAL              // ^
#define JP_AMPERSAND    LS(N6)             // &
#define JP_TILDE        LS(EQUAL)          // ~
#define JP_ASTERISK     LS(QUOT)           // *
#define JP_AT           LEFT_BRACKET       // @
#define JP_EQUAL        LS(MINUS)          // =
#define JP_COLON        QUOT               // :
#define JP_LPAREN       LS(N8)             // (
#define JP_RPAREN       LS(N9)             // )
#define JP_LBRACKET     RIGHT_BRACKET      // [
#define JP_RBRACKET     BACKSLASH          // ]
#define JP_LBRACE       LS(RIGHT_BRACKET)  // {
#define JP_RBRACE       LS(BACKSLASH)      // }
#define JP_YEN          INT3               // ￥
#define JP_UNDERSCORE   LS(INT1)           // _

/ {
    behaviors {
        slow_move: slow_move {
            compatible = "zmk,behavior-input-two-axis";
            x-input-code = <INPUT_REL_X>;
            y-input-code = <INPUT_REL_Y>;
            time-to-max-speed-ms = <4000>;
            delay-ms = <16>;
            acceleration-exponent = <0>;
        };
    };
};

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

/ {
    combos { compatible = "zmk,combos"; };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q             &kp W                           &kp E      &kp R         &kp T           &kp Y           &kp U           &kp I        &kp O      &kp P
&kp A             &kp S                           &kp D      &kp F         &kp G           &kp H           &kp J           &kp K        &kp L      &lt 3 MINUS
&mt LEFT_SHIFT Z  &kp X                           &kp C      &kp V         &kp B           &kp LANGUAGE_2  &kp LANGUAGE_1  &kp N        &kp M      &kp COMMA
&kp DOT           &mt RSHIFT LS(INTERNATIONAL_1)  &kp LCTRL  &kp LEFT_WIN  &lt 2 LEFT_ALT  &lt 5 SPACE      &kp BACKSPACE   &lt 1 ENTER  &lt 4 TAB  &kp DEL
            >;
        };

        layer_1 {
            bindings = <
&trans  &trans   &trans  &trans  &trans  &kp F1  &kp F2  &kp F3        &kp F4  &kp F5
&trans  &trans   &trans  &trans  &trans  &kp F6  &kp F7  &kp F8        &kp F9  &kp F10
&trans  &trans   &trans  &trans  &trans  &trans  &trans  &kt LS(CLCK)  &trans  &trans
&trans  &kp F11  &trans  &trans  &trans  &trans  &trans  &trans        &trans  &kp F12
            >;
        };

        layer_2 {
            bindings = <
&kp MINUS          &kp N7                 &kp N8   &kp N9    &kp JP_PLUS      &kp JP_CARET     &kp JP_AMPERSAND  &kp JP_TILDE   &kp JP_LBRACKET  &kp JP_RBRACKET
&kp SLASH          &kp N4                 &kp N5   &kp N6    &kp JP_ASTERISK  &kp EXCLAMATION  &kp JP_AT          &kp HASH       &kp DOLLAR       &kp PERCENT
&mt LEFT_SHIFT N0  &kp N1                 &kp N2   &kp N3    &kp PERIOD       &kp JP_EQUAL     &kp JP_COLON      &kp SEMICOLON  &kp JP_LPAREN    &kp JP_RPAREN
&kp BACKSLASH      &mt RIGHT_SHIFT SLASH  &kp ESC  &kp INT3  &trans           &kp JP_YEN       &kp LS(N2)        &kp LS(N7)     &kp LS(COMMA)    &kp LS(PERIOD)
            >;
        };

        layer_3 {
            bindings = <
&kp ESCAPE           &kp LC(LS(TAB))         &kp UP_ARROW    &kp LC(TAB)              &trans   &trans  &trans     &msc SCRL_UP  &trans               &trans
&kp HOME             &kp LEFT_ARROW          &kp DOWN_ARROW  &kp RIGHT_ARROW          &kp END  &trans  &mkp LCLK  &mkp MCLK     &mkp RCLK            &trans
&kp LEFT_SHIFT       &kp LG(LS(LEFT_ARROW))  &trans          &kp LG(LS(RIGHT_ARROW))  &trans   &trans  &trans     &trans        &kp LA(LEFT_ARROW)   &msc SCRL_DOWN
&kp LA(RIGHT_ARROW)  &trans                  &trans          &trans                   &trans   &trans  &trans     &trans        &trans               &trans
            >;
        };

        layer_4 {
            bindings = <
&trans  &trans      &trans  &trans  &trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans      &trans  &trans  &trans  &trans        &trans        &trans        &trans        &trans
&trans  &trans      &trans  &trans  &trans  &trans        &bootloader   &trans        &trans        &trans
&trans  &bt BT_CLR  &trans  &trans  &trans  &trans        &trans        &trans        &trans        &bt BT_CLR_ALL
            >;
        };

        layer_5 {
            bindings = <
&trans  &trans      &trans           &trans             &trans        &trans        &trans  &trans  &trans  &trans
&trans  &trans      &trans           &trans             &trans        &trans        &trans  &trans  &trans  &trans
&trans  &kp C_MUTE  &kp C_VOLUME_UP  &kp C_VOLUME_DOWN  &kp C_BRI_DN  &kp C_BRI_UP  &trans  &trans  &trans  &trans
&trans  &trans      &trans           &trans             &trans        &trans        &trans  &trans  &trans  &trans
            >;
        };

        MOUSE {
            bindings = <
&kp ESCAPE           &kp LC(LS(TAB))         &kp UP_ARROW    &kp LC(TAB)              &trans   &trans  &trans     &msc SCRL_UP  &trans               &trans
&kp HOME             &kp LEFT_ARROW          &kp DOWN_ARROW  &kp RIGHT_ARROW          &kp END  &trans  &mkp LCLK  &mkp MCLK     &mkp RCLK            &trans
&kp LEFT_SHIFT       &kp LG(LS(LEFT_ARROW))  &trans          &kp LG(LS(RIGHT_ARROW))  &trans   &trans  &trans     &trans        &kp LA(LEFT_ARROW)   &msc SCRL_DOWN
&kp LA(RIGHT_ARROW)  &trans                  &trans          &trans                   &trans   &trans  &trans     &trans        &trans               &trans
            >;
        };
    };
};
